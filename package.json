{
  "name": "parley-room",
  "version": "1.3.0-personal.0",
  "private": true,
  "description": "A local conversation room with an editable roster of individually configured Claude, Codex, and Gemini agents.",
  "type": "module",
  "bin": {
    "parley": "parley.mjs",
    "parley-mine": "bin/parley-mine.mjs",
    "parley-bridge": "bin/parley-bridge.mjs",
    "parley-bridge-setup": "bin/parley-bridge-setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/parley-mine.mjs",
    "test": "node test/smoke.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:browser": "playwright test --config test/browser.config.mjs",
    "test:unit": "node --test test/unit.mjs",
    "test:retry": "node test/retry.mjs",
    "test:automatic": "node test/automatic.mjs",
    "test:claude-sessions": "node test/claude-sessions.mjs",
    "test:provenance": "node test/provenance.mjs",
    "test:sequences": "node test/scheduler-sequences.mjs",
    "bench": "node test/benchmark.mjs",
    "test:integration": "npm run test:retry && npm run test:provenance && npm run test:sequences && npm run test:automatic && npm run test:claude-sessions && npm run test:multi-agent && npm run test:roster-edit && npm run test:launcher && npm run test:convergence && npm run test:bridge",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:smoke && npm run test:browser && npm run test:package",
    "test:package": "node test/package.mjs",
    "test:launcher": "node test/launcher.mjs",
    "test:multi-agent": "node test/multi-agent.mjs",
    "test:roster-edit": "node test/roster-edit.mjs",
    "test:convergence": "node --test test/convergence-integrity.mjs && node test/convergence.mjs",
    "test:bridge-adapter": "node --test test/bridge-adapter.mjs",
    "test:bridge": "node --test test/bridge-adapter.mjs test/bridge-backend.mjs test/bridge-backend-lifecycle.mjs && node test/bridge-e2e.mjs",
    "desktop": "electron .",
    "desktop:build": "node scripts/package-desktop.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rortegalizardo/parley.git"
  },
  "homepage": "https://github.com/rortegalizardo/parley#readme",
  "keywords": [
    "claude-code",
    "codex",
    "cli",
    "multi-agent",
    "chat"
  ],
  "files": [
    "bin/",
    "parley.mjs",
    "lib/",
    "ui/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/HARNESS-BRIDGE.md"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^45.1.0",
    "@electron/packager": "^20.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "main": "desktop/main.cjs",
  "productName": "Parley"
}
